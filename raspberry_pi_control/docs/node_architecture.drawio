row=block;" edge="1" source="ready" target="commit" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="commit" target="run" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="全部完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="run" target="done" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="确认缺失" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="commit" target="partial" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="失联" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="run" target="degrade" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="恢复通信" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="degrade" target="reconnect" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="本地完成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="reconnect" target="done" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="取消执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="stop" target="run" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="重启" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" source="run" target="restart" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>